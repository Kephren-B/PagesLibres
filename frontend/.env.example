# URL de l'API PagesLibres
VITE_API_URL=http://localhost:8090

# Clé API Google Books (F2, recherche par ISBN). Optionnelle : la lecture
# publique de l'API fonctionne sans clé, avec un quota plus restreint.
# Une clé côté client (Vite) finit dans le bundle JS livré au navigateur :
# ce n'est pas un secret au sens strict, restreignez-la par référent HTTP
# (HTTP referrer) dans la console Google Cloud plutôt que de compter sur
# son opacité.
VITE_GOOGLE_BOOKS_API_KEY=
