# Copier ce fichier vers .env (ou .env.local) et générer un vrai secret :
#   php bin/console secrets:generate-keys   # ou: php -r 'echo bin2hex(random_bytes(16));'

APP_ENV=dev
APP_SECRET=changeme_generate_a_real_secret
APP_SHARE_DIR=var/share

DEFAULT_URI=http://localhost

# Valeurs par défaut pour un usage hors Docker ; en environnement Docker
# Compose, DATABASE_URL est injectée par docker-compose.yml (service php)
# et pointe vers le service "database" avec les identifiants de .env.example
# à la racine du repo.
DATABASE_URL="postgresql://pageslibres:changeme_dev_only@127.0.0.1:5432/pageslibres?serverVersion=18&charset=utf8"

# JWT (lexik/jwt-authentication-bundle) : générer la paire de clés avec
#   php bin/console lexik:jwt:generate-keypair
# après avoir défini une vraie passphrase ci-dessous.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme_generate_a_real_passphrase

# CORS (nelmio/cors-bundle) : origines autorisées à appeler l'API — le
# front Vite en dev (localhost:5173) par défaut, jamais "*".
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
