# Copier ce fichier vers .env.prod puis adapter les valeurs réelles :
#   cp .env.prod.example .env.prod
# Lancer la stack publiée :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- Base de données (PostgreSQL + PostGIS) ---
POSTGRES_DB=pageslibres
POSTGRES_USER=pageslibres
POSTGRES_PASSWORD=changeme_generate_a_real_db_password

# --- Symfony ---
# Secret de l'application (générer : php -r 'echo bin2hex(random_bytes(16));')
APP_SECRET=changeme_generate_a_real_secret

# URI de base de l'application (utilisée par certaines configs Symfony)
DEFAULT_URI=http://localhost

# Origines autorisées à appeler l'API (le front en local par défaut)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# --- JWT ---
# Passphrase des clés JWT (générées au premier démarrage du conteneur si
# absentes — elles ne sont jamais versionnées).
JWT_PASSPHRASE=changeme_generate_a_real_passphrase

# --- Images Docker Hub ---
# TAG à utiliser (défaut: latest) ; sur un tag v*, CI publie version + latest.
TAG=latest
